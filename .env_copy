ENV=LOCAL
PORT=9000
SSL=TRUE
API_VERSION=2.0
DB_USER="postgres"
DB_PASS="postgres"
DB_NAME="golang_gin_db"
# Placeholders only. Generate a separate value per secret and per environment from
# 32+ random bytes, e.g. `openssl rand -base64 48`. The server refuses to start while
# ACCESS_SECRET or REFRESH_SECRET still start with CHANGE_ME. Values that earlier
# versions of this file committed are public: rotate any secret copied from it.
ACCESS_SECRET="CHANGE_ME_access_secret_openssl_rand_base64_48"
REFRESH_SECRET="CHANGE_ME_refresh_secret_openssl_rand_base64_48"
REDIS_SECRET="CHANGE_ME_redis_secret_openssl_rand_base64_48"
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=
# HMAC key the payment provider signs top-up webhooks with (32+ random bytes, same
# rules as the JWT secrets). Leave empty to disable POST /v1/webhooks/topup.
PAYMENT_WEBHOOK_SECRET=
# Per-user top-up limits: one credit, and the total over a rolling 24 hours.
TOPUP_MAX_PER_TRANSACTION=10000000
TOPUP_MAX_PER_DAY=20000000
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=
